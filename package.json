{
  "name": "esperanzakonva-forge",
  "version": "1.0.0",
  "description": "High-performance in-canvas rich text engine and graphic design suite by FlaskArchitect",
  "author": "FlaskArchitect",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.flaskarchitect.esperanzakonvaforge",
    "productName": "EsperanzaKonvaForge",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    }
  },
  "dependencies": {
    "konva": "^10.9.0",
    "lucide": "^1.62.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
